# GastriClin – configuração do servidor (Hostinger / Apache / LiteSpeed)

Options -Indexes
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS e o domínio sem "www"
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Pastas e arquivos internos: acesso direto proibido (código, dados do painel, ferramentas, Git, documentação)
  RewriteRule ^(app|conteudo|dados-iniciais|ferramentas|originais)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(md|py|mjs|sh|yml|yaml|lock)$ - [F,L]

  # Arquivos e pastas reais são entregues direto; o resto vai para o index.php (páginas, blog e redirecionamentos)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache do navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Segurança (Lighthouse "Boas práticas")
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Cache de página do LiteSpeed (Hostinger): páginas públicas prontas por 1 hora; o painel nunca é cacheado
<IfModule LiteSpeed>
  CacheLookup on
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule .* - [E=Cache-Control:max-age=3600]
</IfModule>

# Uploads: só imagens podem ser servidas
<FilesMatch "\.(php|phtml|phar)$">
  <If "%{REQUEST_URI} =~ m#^/uploads/#">
    Require all denied
  </If>
</FilesMatch>
